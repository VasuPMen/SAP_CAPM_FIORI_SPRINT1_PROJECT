{
  "_version": "1.65.0",
  "sap.app": {
    "id": "rental.equipment",
    "type": "application",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "title": "Rental Equipment Management",
    "description": "Equipment Rental, Inspection, Maintenance and Billing",
    "dataSources": {
      "mainService": {
        "uri": "/analytics/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.fe.templates": {}
      }
    },
    "models": {
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "EquipmentList",
          "target": "EquipmentList"
        },
        {
          "pattern": "Equipment({key}):?query:",
          "name": "EquipmentObjectPage",
          "target": "EquipmentObjectPage"
        }
      ],
      "targets": {
        "EquipmentList": {
          "type": "Component",
          "id": "EquipmentList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/Equipment"
            }
          }
        },
        "EquipmentObjectPage": {
          "type": "Component",
          "id": "EquipmentObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "contextPath": "/Equipment"
            }
          }
        }
      }
    }
  }
}
